		pcall(MoonClockTick)
	end
end)

MoonPhaseIndex = function()
	local moonTextureId = Lighting:FindFirstChild(Sea2 and "FantasySky" or "Sky")
	moonTextureId = moonTextureId and moonTextureId.MoonTextureId
	if not moonTextureId then
		return nil
	end

	for i, v in ipairs(MoonPhaseIds) do
		if v == moonTextureId then
			return i
		end
	end

	return nil
end

MoonUnitsToFull = function(arg, arg2)
	if not arg then
		return nil
	end
	arg2 = arg2 or Lighting.ClockTime

	if arg == MoonFullIndex then
		if arg2 < MoonEndClock then
			return 0
		end

		if arg2 >= MoonFullClock then
			return 0
		end
		return MoonFullClock - arg2
	end

	if arg == MoonAfterFullIndex and arg2 < MoonEndClock then
		return 0
	end
	local n3 = (MoonFullIndex - arg) % MoonPhaseCount * 24 + MoonFullClock - arg2

	if n3 < 0 then
		n3 = 0
	end

	return n3
end

MoonMinutesToFull = function(arg, arg2)
	local v = MoonUnitsToFull(arg, arg2)
	if v == nil then
		return nil
	end
	local n3 = MoonClockPerMin

	if not n3 or n3 <= 0 then
		n3 = 1
	end

	return math.max(0, math.floor(v / n3 + 0.5))
end

MoonCountdownText = function(arg)
