TrackedQuestCache = { at = 0, visible = false, text = "" }

GetTrackedQuest = function()
	local now = os.clock()
	if now - TrackedQuestCache.at < 0.3 then
		return TrackedQuestCache.visible, TrackedQuestCache.text
	end
	TrackedQuestCache.at = now
	local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
	playerGui = playerGui and playerGui:FindFirstChild("TrackedQuestFrame")

	if not playerGui then
		local v = TrackedQuestCache
		TrackedQuestCache.visible = false
		v.text = ""
		return false, ""
	end

	local frame = playerGui:FindFirstChild("Frame") or playerGui

	if not frame then
		local v = TrackedQuestCache
		TrackedQuestCache.visible = false
		v.text = ""
		return false, ""
	end

	local enabled

	if frame:IsA("ScreenGui") then
		enabled = frame.Enabled
	elseif frame:IsA("GuiObject") then
		enabled = frame.Visible
	else
		enabled = false
	end

	local tbl = {}

	for _, descendant in ipairs(frame:GetDescendants()) do
		if descendant:IsA("TextLabel") and descendant.Text ~= "" then
			tbl[#tbl + 1] = descendant.Text
		end
	end

	local text = table.concat(tbl, " ")
	local v = TrackedQuestCache
	TrackedQuestCache.visible = enabled
	v.text = text
	return enabled, text
end

