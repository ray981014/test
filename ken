MagnetSpotIndex = 0

AutoCraftVolcanicMagnetFlow = function()
	if VolcanoAppeared() then
		if Draco.Borrowed then
			Draco.ReleaseBlaze()
		end

		return
	end

	if not MagnetRunning() then
		return
	end

	if CraftVolcanicMagnet() then
		return
	end

	if CountItem("Scrap Metal") < 10 then
		local v = FindMob({ ["Jungle Pirate"] = true, ["Musketeer Pirate"] = true })

		if v then
			_tp(function()
				if not Attack.Alive(v) then
					return nil
				end
				return GetHoverCFrame(v)
			end, function()
				return not MagnetRunning() or not Attack.Alive(v)
			end)

			Attack.Kill(v, true)
			return
		end

		MagnetSpotIndex = MagnetSpotIndex % #ScrapMetalSpots + 1
		local v2 = ScrapMetalSpots[MagnetSpotIndex]

		if v2 then
			_tp(CFrame.new(v2), function()
				return not MagnetRunning()
			end)
		end

		return
	end

	if CountItem("Blaze Ember") < 15 and Draco then
		Draco.BorrowEmber(true)

		if Draco.EmberRunning() then
			Draco.AutoFarmBlaze()
		end
	end
end

