	local tbl3 = {}

	for _, descendant in ipairs(arg:GetDescendants()) do
		if descendant:IsA("MeshPart") then
			tbl3[descendant.MeshId] = true
		end
	end

	for k, v in pairs(FruitMeshNames) do
		if tbl3[k] then
			return v
		end
	end

	local fruit = arg:FindFirstChild("Fruit")

	if fruit then
		if fruit:FindFirstChild("Retopo_Cube.001") then
			return "Spirit"
		end

		if fruit:FindFirstChild("Gravity cube.026") then
			return fruit:FindFirstChild("Gravity cube.001") and "Blizzard" or "Portal"
