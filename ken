FishingFlow = function()
	local character = LocalPlayer.Character
	local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoidRootPart then
		return
	end
	local v = DetectRod()
	if not v then
		return
	end

	if v.Parent == LocalPlayer:FindFirstChild("Backpack") then
		local humanoid = character:FindFirstChildOfClass("Humanoid")

		if humanoid then
			pcall(function()
				humanoid:EquipTool(v)
			end)
		end

		task.wait(0.5)
		return
	end

	local v2 = GetFishingRequest()
	if not v2 then
		return
	end

	if (v:GetAttribute("SkillChargeAlpha") or 0) >= 1 then
		local v3 = GetFishingRemotes()

		if v3 and v3.JobAbilities then
			pcall(function()
				v3.JobAbilities:InvokeServer("Z", true)
			end)
		end
	end

	local attribute = v:GetAttribute("ServerState")

	if not attribute or attribute == "ReeledIn" then
		FishBiteAt = nil
		EnsureBait()

		pcall(function()
			v2:InvokeServer("StartCasting")
		end)

		task.wait(0.7)
		local v3, v4 = FishCastTarget(humanoidRootPart, v, 98)
		if not v3 then
			return
		end
		local flag3 = false

		pcall(function()
			flag3 = v2:InvokeServer("CastLineAtLocation", v3, 98, v4)
		end)

		if not flag3 then
			EquipWeapon("Melee")
			return
		end
		return
	end

	if attribute == "Biting" then
		if not FishBiteAt then
			FishBiteAt = tick()
		end

		local v3 = FishBiteAt

		if tick() - v3 >= 5 then
			EquipWeapon("Melee")
			task.wait(1)
			FishBiteAt = nil
		end

		return
	end

	FishBiteAt = nil
end

