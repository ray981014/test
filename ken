Sea2RunFlow = function()
	if Sea2Running then
		return
	end
	Sea2Running = true

	local ok2, result2 = pcall(function()
		if not _G.AutoSea2 or not Sea1 then
			return
		end

		if LocalPlayer.Data.Level.Value < 700 then
			return
		end
		local v = Sea2Progress()
		if not v then
			return
		end

		if v.UsedKey and v.KilledIceBoss then
			Sea2Travel()
			return
		end
		local map = Workspace:FindFirstChild("Map")
		map = map and map:FindFirstChild("Ice")
		local door = map and map:FindFirstChild("Door")
		if not door then
			return
		end

		if not v.TalkedDetective then
			CommF:InvokeServer("DressrosaQuestProgress", "Detective")
			task.wait(0.5)
			return
		end

		if not v.UsedKey then
			if not GetKey() then
				CommF:InvokeServer("DressrosaQuestProgress", "Detective")
				task.wait(1)
				return
			end

			EquipKey()
			if not Sea2Goto(Sea2Door, 180) then
				return
			end

			if not TouchIceDoor(GetKey(), door) then
				Sea2Goto(CFrame.new(1300, 28, -1362), 30)
			end

			task.wait(1)
			return
		end

		local v2 = GetIceAdmiral()
		if v2 then
			Sea2Kill(v2, 300)
			return
		end

		if not Sea2Goto(Sea2Door, 120, function()
			return GetIceAdmiral() ~= nil
		end) then
			return
		end

		if not GetIceAdmiral() then
			Sea2Travel()
		end
	end)

	if not ok2 then
		warn("[AutoSea2] " .. tostring(result2))
	end

	Sea2Running = false
end

