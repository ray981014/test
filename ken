ItemCountCache = nil
ItemCountCacheAt = 0

CountsFromCraftData = function()
	local tbl3 = {}

	pcall(function()
		local rfGetCraftPlayerData = Net:FindFirstChild("RF/GetCraftPlayerData")
		if not rfGetCraftPlayerData then
			return
		end
		local response = rfGetCraftPlayerData:InvokeServer()
		local etcItems = type(response) == "table" and response.EtcItems
		if type(etcItems) ~= "table" then
			return
		end

		for k, etcItem in pairs(etcItems) do
			if type(etcItem) == "number" then
				tbl3[k] = etcItem
			elseif type(etcItem) == "table" then
				local quantity = etcItem.Quantity or etcItem.Count or etcItem.Amount or etcItem.Value

				if type(quantity) == "number" then
					tbl3[k] = quantity
				end
			end
		end
	end)

	return tbl3
end

CountsFromItemService = function()
	local tbl3 = {}

	pcall(function()
		local ItemReplicationService = require(RS:WaitForChild("ItemReplicationService", 5))
		local ItemConfig = require(RS:WaitForChild("ItemConfig", 5))
		if not ItemReplicationService or not ItemConfig then
			return
		end

		for _, v in ipairs(ItemReplicationService:GetItems(ItemReplicationService.KEYS.QUANTITY)) do
			if v.Value and v.Value > 0 then
				local ok2, result2 = pcall(function()
					return ItemConfig.match(v.ItemId):unwrap()
				end)

				ok2 = ok2 and result2 and result2.Display
				local name = nil

				if ok2 then
					name = result2.Display.Name or result2.Index and result2.Index.StorageKey
				end

				if name then
					tbl3[name] = (tbl3[name] or 0) + v.Value
				end
			end
		end
	end)

	return tbl3
end

CountsFromBackpack = function()
	local tbl3 = {}

	local function fn3(arg)
		if not arg then
			return
		end

		for _, child in ipairs(arg:GetChildren()) do
			if child:IsA("Tool") then
				local attribute = child:GetAttribute("Count") or child:GetAttribute("Amount")

				if not attribute then
					attribute = child:FindFirstChild("Count") or child:FindFirstChild("Amount")
					attribute = attribute and attribute.Value
				end

				tbl3[child.Name] = (tbl3[child.Name] or 0) + (tonumber(attribute) or 1)
			end
		end
	end

	fn3(LocalPlayer:FindFirstChild("Backpack"))
	fn3(LocalPlayer.Character)
	return tbl3
end

BuildItemCounts = function()
	local tbl3 = {}
	local v = ipairs
	local tbl4 = {}
	local v2 = CountsFromCraftData()
	local v3 = CountsFromItemService()
	local v4 = CountsFromBackpack
	tbl4[1] = v2
	tbl4[2] = v3

	do
		local values = table.pack(v4())
		table.move(values, 1, values.n, 3, tbl4)
	end

	for _, v5 in v(tbl4) do
		for k, v6 in pairs(v5) do
			if tbl3[k] == nil then
				tbl3[k] = v6
			end
		end
	end

	return tbl3
end

GetItemCounts = function(arg)
	local now = tick()
	if not arg and ItemCountCache and now - ItemCountCacheAt < 2 then
		return ItemCountCache
	end
	ItemCountCache = BuildItemCounts()
	ItemCountCacheAt = now
	return ItemCountCache
end

