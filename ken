DetectRockVolcano = function()
	local volcanoRocks = VolcanoCore()
	volcanoRocks = volcanoRocks and volcanoRocks:FindFirstChild("VolcanoRocks")
	if not volcanoRocks then
		return nil
	end
	local v = GetHRP()
	local v2 = nil
	local v3 = nil

	for _, child in ipairs(volcanoRocks:GetChildren()) do
		local vfxLayer = child:FindFirstChild("VFXLayer")
		vfxLayer = vfxLayer and vfxLayer:FindFirstChild("Specs")

		if child.Name == "Rock" and vfxLayer and vfxLayer.Enabled and v then
			local magnitude = (v.Position - child:GetPivot().Position).Magnitude

			if not v2 or magnitude < v2 then
				v2 = magnitude
				v3 = child
			end
		end
	end

	return v3
end

