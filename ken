BoardBoatSmooth = function(arg, arg2)
	local n3 = tick() + (arg2 or 20)

	while SailActive() and tick() < n3 do
		local v = GetHumanoid()
		local v2 = arg and GetBoatSeat(arg)
		if not v2 or not arg.Parent then
			return false
		end

		if v and v.Sit and v.SeatPart == v2 then
			return true
		end

		_tp(function()
			local v3 = GetBoatSeat(arg)
			return v3 and v3.CFrame or nil
		end, function()
			local v3 = GetHumanoid()
			local v4 = GetBoatSeat(arg)
			return not SailActive() or not v4 or v3 ~= nil and v3.Sit and v3.SeatPart == v4
		end)

		task.wait(0.05)
	end

	local v = GetHumanoid()
	arg = arg and GetBoatSeat(arg)
	return v ~= nil and arg ~= nil and v.Sit and v.SeatPart == arg
end

VolcanoSailFlow = function()
	if VolcanoSailRunning then
		return
	end
	VolcanoSailRunning = true
	local smartTeleport = _G.SmartTeleport
	_G.SmartTeleport = false
	SailNoclipActive = true

	pcall(function()
		local lvInfinite = SeaZoneCF["Lv Infinite"]
		if not lvInfinite then
			return
		end

		while SailActive() do
			local map = Workspace:FindFirstChild("Map")

			if not (map and map:FindFirstChild("PrehistoricIsland")) then
				local parent = GetOwnBoat() or BuyBoatAndWait(true, SailActive)

				if not parent then
					task.wait(1)
				else
					local flag3 = false

					for i = 1, 3 do
						if SailActive() then
							parent = parent and parent.Parent and parent or GetOwnBoat()

							if parent then
								if BoardBoatSmooth(parent, 20) then
									flag3 = true
									break
								else
									task.wait(0.3)
									continue
								end
							end
						end

						break
					end

					if not flag3 then
						task.wait(1)
					else
						while _G.SailToPrehistoric do
							local n3 = RunService.Heartbeat:Wait() or 0.016666666666666666

							if SailActive() then
								local map2 = Workspace:FindFirstChild("Map")

								if not (map2 and map2:FindFirstChild("PrehistoricIsland")) then
									local v = GetHRP()
									local v2 = GetHumanoid()

									if not (not v or not v2) then
										if not (v2.Sit and v2.SeatPart) then
											BoardBoatSmooth(parent, 15)
											break
										else
											local position = v.Position
											local vector = Vector3.new(lvInfinite.Position.X - position.X, 0, lvInfinite.Position.Z - position.Z)
											if not (vector.Magnitude <= SailArriveDist) then
												DriveBoatStep(v, vector, n3)
												continue
											end
										end
									end
								end
							end

							break
						end
					end
				end

				continue
			end

			break
		end
	end)

	SailNoclipActive = false

	if VolcanoRunning() then
		local map = Workspace:FindFirstChild("Map")
		map = map and map:FindFirstChild("PrehistoricIsland")

		if map then
			local v = GetHumanoid()

			if v then
