	playerGui = playerGui and playerGui:FindFirstChild("Main")
	playerGui = playerGui and playerGui:FindFirstChild("TopHUDList")
	if not playerGui then
		return false
	end
	local prehistoricRaidTimer = playerGui:FindFirstChild("PrehistoricRaidTimer")
	local raidTimer = playerGui:FindFirstChild("RaidTimer")
	return prehistoricRaidTimer and prehistoricRaidTimer.Visible or raidTimer and raidTimer.Visible or false
end

