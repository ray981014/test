		local v2 = T(v)
		tbl[i] = v2
		tbl2[v2] = v
	end

	return tbl, tbl2
end

SelBack = function(arg, arg2)
	if type(arg2) == "table" then
		local tbl = {}

		for i, v in ipairs(arg2) do
			v = arg[v] or v
			tbl[i] = v
		end

		return tbl
	end

	return arg[arg2] or arg2
end

