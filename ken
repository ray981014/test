Dojo.Flow = function()
	if not getgenv().QuestTrainer then
		if not Dojo.At(Dojo.Pos.Position) then
			_tp(Dojo.Pos)
			return
		end
		local RequestQuest = Dojo.Invoke("RequestQuest")
		if not RequestQuest or type(RequestQuest.Quest) ~= "table" then
			return
		end

		if RequestQuest.Quest.Progress >= RequestQuest.Quest.Goal then
			Dojo.Invoke("ClaimQuest")
			task.wait(1)
			return
		end

		local beltName = RequestQuest.Quest.BeltName
		local v = DojoBeltKind[beltName]

		if not v then
			Notify({
				Type = "warning",
				Title = "美團 HUB",
				Message = T("目前不支持该任务") .. ": " .. tostring(beltName) .. T("带"),
				Duration = 8,
			})

			_G.AutoQuestDojo = false
			getgenv().QuestTrainer = nil
			return
		end

		local questTrainer = {
			BeltName = beltName,
			Kind = v,
			Count = 0,
			Need = tonumber(RequestQuest.Quest.Goal) or DojoBeltNeed[beltName] or 1,
			Progress = RequestQuest.Quest.Progress,
		}

		getgenv().QuestTrainer = questTrainer
		return
	end

	local questTrainer = getgenv().QuestTrainer
	if (questTrainer.Need or DojoBeltNeed[questTrainer.BeltName] or 1) <= questTrainer.Count then
		getgenv().QuestTrainer = nil
		return
	end

	if questTrainer.Kind == "mob" then
		local v = GetCurrentLevelMob()
		local v2 = v and FindEnemy(v.Enemies[1])

		if v2 then
			KillLoop(v2, function()
				return _G.AutoQuestDojo
			end)

			questTrainer.Count = questTrainer.Count + 1
		elseif v then
			if not GetTrackedQuest() then
				CommF:InvokeServer("StartQuest", v.Quest[2], v.Quest[3])
			else
				WaitAtSpots(v.Positions, function()
					return _G.AutoQuestDojo
				end)
			end
		end

		return
	end

	if questTrainer.Kind == "elite" then
		if Dojo.KillElite() then
			questTrainer.Count = questTrainer.Count + 1
		end

		return
	end

	if questTrainer.Kind == "wait" then
		local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
		playerGui = playerGui and playerGui:FindFirstChild("Main")
		playerGui = playerGui and playerGui:FindFirstChild("Compass")
		local frame = playerGui and playerGui:FindFirstChild("Frame")
		frame = frame and frame:FindFirstChild("DangerLevel")
		local visible = frame and frame.Visible

		if visible then
			visible = tonumber(frame.TextLabel and frame.TextLabel.Text) == 6
		end

		local now = tick()

		if now - Dojo.CheckAt >= 3 then
			Dojo.CheckAt = now
			local RequestQuest = Dojo.Invoke("RequestQuest")
			RequestQuest = RequestQuest and RequestQuest.Quest
			if type(RequestQuest) == "table" and tonumber(RequestQuest.Progress) and tonumber(RequestQuest.Goal) and RequestQuest.Progress >= RequestQuest.Goal then
				getgenv().QuestTrainer = nil
				return
			end

			if type(RequestQuest) == "table" and tonumber(RequestQuest.Goal) then
				local need = tonumber(RequestQuest.Goal)
				local progress = tonumber(RequestQuest.Progress) or 0
				questTrainer.Need = need
				questTrainer.Progress = progress
			end
		end

		if not visible then
			Dojo.SailOut()
		end

		return
	end

	local v = Dojo.FindSeaTarget()

	if v then
		Dojo.KillSeaEvent(v)
		questTrainer.Count = questTrainer.Count + 1
		return
	end

	Dojo.SailOut()
end

Dojo.FindSeaTarget = function()
