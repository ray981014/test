	ServerTimeStart = nil
	ServerTimeScanTries = 0
	ServerTimeScanMax = 3

	ScanServerStart = function()
		if ServerTimeStart or ServerTimeScanTries >= ServerTimeScanMax then
			return
		end
		ServerTimeScanTries = ServerTimeScanTries + 1

		pcall(function()
			for _, v9 in pairs(getgc(true)) do
				if type(v9) == "table" and rawget(v9, "_group") == "Environment" then
					local value = rawget(v9, "timeIn")
					if type(value) == "number" and value > 1.7e9 then
						ServerTimeStart = value
						break
					end
				end
			end
		end)
	end

	GetServerStart = function()
		ScanServerStart()
		if ServerTimeStart then
			return ServerTimeStart
		end
		return os.time() - math.floor(workspace.DistributedGameTime)
	end

	FormatHMS = function(arg2)
		local n3 = math.max(0, math.floor(arg2))
		return string.format("%02d:%02d:%02d", math.floor(n3 / 3600), math.floor(n3 % 3600 / 60), n3 % 60)
	end

