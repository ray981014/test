ShootHeartLeviathan = function()
	local map = Workspace:FindFirstChild("Map")
	map = map and map:FindFirstChild("FrozenHeart")
	if not map then
		HeartSetState(T("射心脏: 等冰心出现"))
		return
	end

	if not _G.AutoShootHeart then
		return
	end
	local inside = map:FindFirstChild("Inside")
	local cube = map:FindFirstChild("Cube")
	if not (inside and cube) then
		return
	end

	if inside:GetAttribute("Harpooned") then
		HeartSetState(T("射心脏: 已射中"))
		task.wait(5)
		return
	end

	local v = GetHeartBoat()

	if not v then
		HeartSetState(T("射心脏: 没找到船"))
		task.wait(2)
		return
	end

	HeartBoatNoclip(v)
	local n3 = CFrame.new(cube.Position.X, v.WorldPivot and v.WorldPivot.Y or v:GetPivot().Y, cube.Position.Z) * CFrame.new(0, 0, 300)
	local v2 = GetBoatSeat(v)

	if v2 and (n3.Position - v2.Position).Magnitude > 5 then
		if SeatedIn("VehicleSeat") then
			HeartSetState(T("射心脏: 开船前往"))
			local tweenInfo = TweenInfo.new((n3.Position - v2.Position).Magnitude / 150, Enum.EasingStyle.Quad)
			local tween = nil

			pcall(function()
				tween = TweenService:Create(v2, tweenInfo, { CFrame = n3 })
				tween:Play()
				tween.Completed:Wait()
			end)

			task.wait(1)
			PointBoatAt(v, inside.Position)
		elseif HeartBoatPick() == T("射心脏: 最近的船") then
			HeartSetState(T("射心脏: 上船"))
			BoardBoat(v, 20, true)
		else
			_tp(v2.CFrame)
		end

		return
	end

	if SeatedIn("Harpoon") then
		HeartSetState(T("射心脏: 发射鱼叉"))

		if not FireHeartHarpoon(v) then
			task.wait(1)
		end

		return
	end

	local harpoon = v:FindFirstChild("Harpoon")
	harpoon = harpoon and harpoon:FindFirstChild("Seat")

	if harpoon then
		HeartSetState(T("射心脏: 去炮台就位"))
		_tp(harpoon.CFrame)
	end
end

