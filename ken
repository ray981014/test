HeartBoatAlive = function(arg)
	local humanoid = arg:FindFirstChild("Humanoid")
	if not humanoid then
		return true
	end

	local ok2, result2 = pcall(function()
		return humanoid.Value
	end)

	if ok2 and result2 ~= nil then
		return result2 > 0
	end

	if humanoid:IsA("Humanoid") then
		return humanoid.Health > 0
	end
	return true
end

GetNearestBoat = function()
	local boats = Workspace:FindFirstChild("Boats")
	if not boats then
		return nil
	end
	local position = GetHRP()
	position = position and position.Position
	if not position then
		return nil
	end
	local huge = math.huge
	local v = nil

	for _, child in ipairs(boats:GetChildren()) do
		if child:IsA("Model") then
			local v2 = GetBoatSeat(child)

			if v2 and HeartBoatAlive(child) then
				local magnitude = (v2.Position - position).Magnitude

				if magnitude < huge then
					huge = magnitude
					v = child
				end
			end
		end
	end

	return v
end

GetHeartBoat = function()
	if HeartBoatPick() == T("射心脏: 最近的船") then
		return GetNearestBoat()
	end
	local boats = Workspace:FindFirstChild("Boats")
	if not boats then
		return nil
	end

	for _, child in ipairs(boats:GetChildren()) do
		if child:IsA("Model") then
			local owner = child:FindFirstChild("Owner")

			if owner then
				local name = LocalPlayer.Name
				owner = tostring(owner.Value) == name
			end

			if owner then
				if HeartBoatAlive(child) and GetBoatSeat(child) then
					return child
				end
			end
		end
	end

	return nil
end

HeartBoatNoclip = function(arg)
	if not arg then
		return
	end

	for _, descendant in ipairs(arg:GetDescendants()) do
		if (descendant:IsA("BasePart") or descendant:IsA("MeshPart")) and descendant.CanCollide then
			descendant.CanCollide = false
		end
	end
end

