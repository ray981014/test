KitsuneSpawnFlow = function()
	if KitsuneIslandActive() then
		if KitsuneDidSail then
			KitsuneDidSail = false
			local sit = GetHumanoid()

			if sit then
				sit = sit.Sit or sit.SeatPart
			end

			if sit then
				ForceUnseat(3)
			end
		end

		return
	end

	if KitsuneSailRunning then
		return
	end

	if not KitsuneSpawnWindow() then
		if _G.KitsuneHop and not KitsuneMoonGood() then
			HopServer(true)
		else
			KitsuneSetStage(T("狐狸岛: 等满月再开船"))
		end

		return
	end

	local v = GetOwnBoat()

	if not v then
		KitsuneSetStage(T("狐狸岛: 去买船"))

		v = BuyBoatAndWait(true, function()
			return _G.KitsuneSpawn
		end)

		if not v then
			return
		end
	end

	local v2 = GetBoatSeat(v)
	if not v2 then
		return
	end
	local v3 = KitsuneSpawnTarget()
	local v4 = GetHumanoid()
	if v4 and v4.Sit and v4.SeatPart == v2 and (v2.Position - v3.Position).Magnitude <= KitsuneArriveDist then
		KitsuneSetStage(T("狐狸岛: 已在生成点等待"))
		return
	end
	KitsuneSailRunning = true

	task.spawn(function()
		local v5 = SailNoclipActive
		SailNoclipActive = true

		pcall(function()
			HeartBoatNoclip(v)
			local v6 = GetHumanoid()

			if not (v6 and v6.Sit and v6.SeatPart == v2) then
				if not BoardBoat(v, 20, true) then
					return
				end
			end

			KitsuneDidSail = true
			KitsuneSetStage(T("狐狸岛: 开船前往"))

			SailToCF(v2, v3, SailEngineSpeed, function()
				return _G.KitsuneSpawn
			end, function()
				return KitsuneIslandActive()
			end)
		end)

		SailNoclipActive = v5
		KitsuneSailRunning = false
	end)
end

