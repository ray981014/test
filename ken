	local n3 = EspPoolCount[arg] or 0
	if arg2 <= n3 then
		return
	end
	local n4 = math.max(arg2, n3 + 8)

	for i = n3 + 1, n4 do
		EspGet(arg .. i)
	end

	EspPoolCount[arg] = n4
end

EspHideFrom = function(arg, arg2)
	local n3 = EspPoolCount[arg] or 0

	for i = arg2 + 1, n3 do
		local v = EspPool[arg .. i]

		if v and v.Visible then
			v.Visible = false
		end
	end
end

