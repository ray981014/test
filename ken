ConfigCopy = function(arg)
	if type(arg) ~= "table" then
		return arg
	end
	local tbl = {}

	for k, v in pairs(arg) do
		tbl[k] = ConfigCopy(v)
	end

	return tbl
end

CollectConfig = function()
	local tbl = {}

	for _, v in ipairs(ConfigKeys) do
		if _G[v] ~= nil then
			tbl[v] = ConfigCopy(_G[v])
		end
	end

	return tbl
end

ApplyConfig = function(arg)
	if type(arg) ~= "table" then
		return
	end

	for _, v in ipairs(ConfigKeys) do
		if arg[v] ~= nil then
			_G[v] = ConfigCopy(arg[v])
		end
	end
end

SaveConfig = function(arg)
	if ConfigSaving or not arg and not ConfigDirty or typeof(writefile) ~= "function" then
		return false
	end
	ConfigSaving = true

	local ok2 = pcall(function()
		if typeof(isfolder) == "function" and typeof(makefolder) == "function" and not isfolder(ConfigFolder) then
			makefolder(ConfigFolder)
		end

		writefile(ConfigFile, HttpService:JSONEncode(CollectConfig()))
	end)

	ConfigSaving = false

	if ok2 then
		ConfigDirty = false
	end

	return ok2
end

LoadConfig = function()
	if typeof(readfile) ~= "function" or typeof(isfile) ~= "function" or not isfile(ConfigFile) then
		return false
	end

	local ok2, result2 = pcall(function()
		return HttpService:JSONDecode(readfile(ConfigFile))
	end)

	if ok2 and type(result2) == "table" then
		ApplyConfig(result2)
		return true
	end
	return false
end

