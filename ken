	local n3 = math.floor(arg / 60)
	local n4 = arg % 60
	if n4 == 0 then
		return T(" (满月还有 ") .. n3 .. T(" 小时)")
	end
	return T(" (满月还有 ") .. n3 .. T(" 小时 ") .. n4 .. T(" 分)")
