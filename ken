		end
		local now = tick()
		local flag3 = nil

		while true do
			if _G.AutoSail then
				local n3 = RunService.Heartbeat:Wait() or 0.016666666666666666
				if _G.LeviathanStop and LeviathanThreatExists() or _G.ReturnTiki then
					return
				end

				if not SeaEventFighting and not ResetRebuyBusy then
					local v3 = GetHRP()
