SeaGunRandomLimb = function(arg)
	local n3 = 0

	for i = 1, SeaGunLimbCount do
		local v = arg:FindFirstChild(SeaGunLimbParts[i])

		if v and v:IsA("BasePart") then
			n3 += 1
		end
	end

	if n3 == 0 then
		return arg:FindFirstChild("HumanoidRootPart")
	end
	local n4 = math.random(1, n3)
	local n5 = 0

	for i = 1, SeaGunLimbCount do
		local v = arg:FindFirstChild(SeaGunLimbParts[i])

		if v and v:IsA("BasePart") then
			n5 += 1
			if n5 == n4 then
				return v
			end
		end
	end

	return arg:FindFirstChild("HumanoidRootPart")
end

