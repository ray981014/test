FixRockCurrent = nil
FixRockUnseated = false
FixRockFlying = false

FixVolcanoRock = function(arg)
	if not GetHRP() or not arg or not arg.Parent then
		FixRockCurrent = nil
		return
	end

	if FixRockCurrent ~= arg then
		FixRockCurrent = arg
		FixRockUnseated = false
		FixRockFlying = false
	end

	if not FixRockUnseated then
		if not ForceUnseat(1, VolcanoRunning) then
			return
		end
		FixRockUnseated = true
	end

	local specs = arg:FindFirstChild("VFXLayer") and arg.VFXLayer:FindFirstChild("Specs")

	if not specs or not specs.Enabled then
		FixRockCurrent = nil
		ReleaseHover()
		return
	end

	if DetectGolem() then
		FixRockCurrent = nil
		ReleaseHover()
		return
	end

	local n3 = arg:GetPivot() * CFrame.new(0, 3, 0)
	HoldCFrame = n3

	if not FixRockFlying then
		FixRockFlying = true

		task.spawn(function()
			_tp(function()
				if not arg.Parent then
					return nil
				end
				return arg:GetPivot() * CFrame.new(0, 3, 0)
			end, function()
				return not VolcanoRunning() or DetectGolem() ~= nil
			end)

			FixRockFlying = false
		end)
	end

	local v = GetHRP()

	if v and (v.Position - n3.Position).Magnitude < 12 then
		FixLavaSkills()
	end
end

GoBusy = false

AutoEventVolcanoFlow = function()
	if not VolcanoCore() then
		return
	end

	if not VolcanoRunning() then
		return
	end

	if not ForceUnseat(3, VolcanoRunning) then
		return
	end

	if not VolcanoRunning() then
		return
	end

	local function fn3(arg, arg2)
		local v = GetHRP()
		local v2 = arg()
		if not v or not v2 then
			return false
		end

		if (v.Position - v2.Position).Magnitude <= (arg2 or 8) then
			GoBusy = false
			return true
		end

		if GoBusy then
			return false
		end
		GoBusy = true

		task.spawn(function()
			_tp(arg, function()
				return not VolcanoRunning() or VolcanoRaidActive() or DetectGolem() ~= nil
			end)

			GoBusy = false
		end)

		return false
	end

	if LocalPlayer:GetAttribute("CurrentLocation") ~= "Prehistoric Island" and not VolcanoRaidActive() then
		if VolcanoRunning() then
			fn3(function()
				local v = DetectFossilExpert()
				return v and v.HumanoidRootPart.CFrame or nil
			end)
		end

		return
	end

	if DetectLava() then
		ClearLavaTouch()
	end

	local interiorLava = VolcanoCore()
	interiorLava = interiorLava and interiorLava:FindFirstChild("InteriorLava")

	if interiorLava and #interiorLava:GetChildren() > 0 then
		DeleteLava()
	end

	if not VolcanoRaidActive() then
		local v = VolcanoCore()
		local activationPrompt = v and v:FindFirstChild("ActivationPrompt")

		if activationPrompt then
			if not VolcanoRunning() then
				return
			end

			if fn3(function()
				return activationPrompt.CFrame
			end, 8) then
				local proximityPrompt = activationPrompt:FindFirstChildOfClass("ProximityPrompt")

				if proximityPrompt and fireproximityprompt then
					pcall(fireproximityprompt, proximityPrompt)
				end

				task.wait(3)
			end

			return
		end

		if VolcanoRunning() then
			fn3(function()
				local v2 = DetectFossilExpert()
				return v2 and v2.HumanoidRootPart.CFrame or nil
			end)
		end

		return
	end

	local v = DetectGolem()

	if v then
		Attack.Kill(v, true)

		_tp(function()
			if not Attack.Alive(v) then
				return nil
			end
			return GetHoverCFrame(v)
		end, function()
			return not VolcanoRunning() or not Attack.Alive(v)
		end)

		return
	end

	local v2 = DetectRockVolcano()

	if v2 and VolcanoRunning() then
		FixVolcanoRock(v2)
	end
end

