MoonClockPerMin = nil
MoonRateAnchor = nil
MoonRateAnchorAt = nil
MoonRateWindow = 20
MoonRateSmooth = 0.15

MoonClockTick = function()
	local clockTime = Lighting.ClockTime
	local now = tick()

	if MoonRateAnchor == nil then
		MoonRateAnchor = clockTime
		MoonRateAnchorAt = now
		return
	end

	local n3 = now - MoonRateAnchorAt
	if n3 < MoonRateWindow then
		return
	end
	local n4 = clockTime - MoonRateAnchor

	if n4 < -12 then
		n4 += 24
	elseif n4 > 12 then
		n4 -= 24
	end

	if n4 <= 0 then
		return
	end
	local n5 = n4 / n3 * 60

	if MoonClockPerMin == nil then
		MoonClockPerMin = n5
	else
		MoonClockPerMin = MoonClockPerMin * (1 - MoonRateSmooth) + n5 * MoonRateSmooth
	end

	MoonRateAnchor = clockTime
	MoonRateAnchorAt = now
end

