ForceUnseat = function(arg, arg2)
	local n3 = tick() + (arg or 5)

	repeat
		if arg2 and not arg2() then
			return false
		end
		local v = GetHumanoid()
		if not v or not v.Sit and v.SeatPart == nil then
			return true
		end

		pcall(function()
			v.Sit = false
			v.PlatformStand = false
		end)

		local v2 = GetHRP()

		if v2 then
			pcall(function()
				v2.CFrame = v2.CFrame + Vector3.new(0, 10, 0)
			end)
		end

		task.wait(0.3)
	until tick() > n3

	local v = GetHumanoid()
	return v == nil or not v.Sit and v.SeatPart == nil
end

