FarmObservationFlow = function()
	local str3 = Sea2 and "Marine Captain" or "Marine Commodore"
	local v = FindMob(str3)
	local spawnPart = v and v:FindFirstChild("HumanoidRootPart") or FindSpawnPart(str3)
	if not spawnPart then
		return
	end

	local char = KenChar()
	if not char then
		KenNoBlurSince = nil
		return
	end

	if not KenUnlocked(char) then
		_G.FarmObservation = false
		Notify({ Type = "warning", Title = "美團 HUB", Message = "該賬號未解鎖見聞色", Duration = 5 })
		return
	end

	if ObsBlurOn() then
		KenNoBlurSince = nil
		KenNextAt = 0
		KenFailCount = 0

		repeat
			task.wait()
			if not _G.FarmObservation or not spawnPart.Parent then
				return
			end
			_tp(function()
				if v and Attack.Alive(v) then
					return v.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
				end
				return spawnPart.CFrame * CFrame.new(0, 60, 0)
			end)
		until not _G.FarmObservation or not ObsBlurOn()

		return
	end

	local dodges = KenDodgesLeft()

	if dodges == 0 then
		if _G.FarmObsHop then
			Notify({ Title = "美團 HUB", Message = "見聞色次數已用完，跳服", Duration = 4 })
			HopServer(true)
		end
		return
	end

	if os.clock() >= KenNextAt then
		if KenFailCount >= 2 then
			KenFailCount = 0
			KenNextAt = os.clock() + 30
			KenNoBlurSince = nil
			return
		end

		KenFire()
		KenFailCount = KenFailCount + 1
		KenNextAt = os.clock() + 2.5

		task.wait(0.5)
		if ObsBlurOn() then
			KenFailCount = 0
			KenNoBlurSince = nil
		end
		return
	end

	if not KenNoBlurSince then
		KenNoBlurSince = os.clock()
	elseif os.clock() - KenNoBlurSince >= 15 then
		KenNoBlurSince = nil
		KenFailCount = 0
		KenNextAt = os.clock() + 5
	end
end

