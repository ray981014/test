getgenv().MeituanHubReload = function(arg)
	local str3 = arg == "TopBar" and "TopBar" or "Sidebar"

	local function fn3(arg2)
		if not arg2 then
			return
		end

		for _, child in ipairs(arg2:GetChildren()) do
			if child:IsA("ScreenGui") and (child.Name:match("^MeituanHubMain") or child.Name:match("^MeituanHubNotify") or child.Name:match("^MeituanHubKey") or child.Name:match("^MeituanHubLoading")) then
				pcall(function()
					child:Destroy()
				end)
			end
		end
	end

	pcall(fn3, game:GetService("CoreGui"))

	pcall(function()
		fn3(game:GetService("Players").LocalPlayer:FindFirstChild("PlayerGui"))
	end)

	task.wait(0.2)
	Window = buildUI(str3)
	ApplyStatusPanel()
	Notify({ Title = "美團 HUB", Message = T("已切换到 ") .. str3 .. T(" 界面"), Duration = 3 })
end

