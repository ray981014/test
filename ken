KitsuneMoonGood = function()
	local v = MoonPhaseIndex()
	if not v then
		return false
	end
	local clockTime = Lighting.ClockTime
	if v == MoonNextNightIndex then
		return true
	end

	if v == MoonFullIndex then
		if clockTime < MoonEndClock then
			return true
		end

		if MoonFullClock <= clockTime then
			return true
		end
		return MoonFullClock - clockTime <= KitsuneSoonUnits
	end

	if v == MoonAfterFullIndex then
		return clockTime < MoonEndClock
	end
	return (MoonUnitsToFull(v, clockTime) or math.huge) <= KitsuneSoonUnits
end

