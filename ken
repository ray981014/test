	if not currentCamera then
		return nil
	end
	local v = currentCamera:WorldToViewportPoint(arg)
	if v.Z <= 0 then
		return nil
	end
	arg2 = arg2 and (arg2 - arg).Magnitude or 0
	local floor = math.floor
	return Vector2.new(v.X, v.Y), floor(arg2)
end

