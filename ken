Notify = function(arg)
	if type(arg) ~= "table" or not Window then
		return
	end
	arg.Type = arg.Type or "good"
	Window:Notify(arg)
end

NormalizeLanguage = function(arg)
	if type(arg) ~= "string" then
		return nil
	end
	local str3 = arg:lower()
	if str3 == "english" or str3 == "en" or str3 == "eng" then
		return "English"
	end

	if str3 == "chinese" or str3 == "zh" or str3 == "cn" or str3 == "chs" or arg == "中文" or arg == "简体中文" then
		return "Chinese"
	end
	return nil
end

